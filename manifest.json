{
  "manifest_version": 3,
  "name": "Vimish",
  "version": "0.1.0",
  "description": "A few Vim keys for the web: j/k, g/G, f, /, n/N.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
